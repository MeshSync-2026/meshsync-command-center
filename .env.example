# MeshSync Command Center dashboard — environment template
# Local:  cp .env.example .env  → npm run dev
# Cloudflare Pages: Settings → Variables and Secrets (Production) — same names.
# VITE_* values are baked into the public JS bundle at build time: URLs only, never secrets.

# Edge Sync service (incidents, events, ingestion batches)
VITE_EDGE_SYNC_URL=http://localhost:4001

# Command Center service (auth, users, squads, zones, devices, clusters, dispatch)
VITE_CC_URL=http://localhost:4002

# true = show "Load demo data" (offline demo only, no backend). Keep false in production.
VITE_DEMO_MODE=false
